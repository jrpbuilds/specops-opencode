{
    "name": "@jrpbuilds/specops-opencode",
    "version": "0.3.0",
    "description": "A lightweight OpenSpec workflow layer for OpenCode with per-phase model selection",
    "license": "MIT",
    "author": "Jake Paine <jrp.builds@proton.me>",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        },
        "./tui": {
            "import": "./dist/tui.js"
        }
    },
    "files": [
        "dist",
        "prompts",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jrpbuilds/specops-opencode.git"
    },
    "bugs": {
        "url": "https://github.com/jrpbuilds/specops-opencode/issues"
    },
    "homepage": "https://github.com/jrpbuilds/specops-opencode#readme",
    "keywords": [
        "opencode",
        "openspec",
        "specops",
        "spec-driven-development",
        "plugin",
        "ai-agents",
        "multi-agent",
        "typescript"
    ],
    "scripts": {
        "build": "bun build src/index.ts src/tui.ts --outdir dist --target node",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "bun test",
        "test:packed": "bun run build && bun scripts/test-packed.mjs",
        "check": "bun run format:check && bun run typecheck && bun test && bun run test:packed"
    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.10"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "1.18.10",
        "@types/bun": "^1.3.0",
        "@types/node": "^24.0.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0"
    }
}
